--- !u!114 &1458918398
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1458918396}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44513323b218ba049826813477c045eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 1070684830}
  conversation:
  - text: What was that? Is this a delivery?
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh, no. It's just the police.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: What are you here for? Noise complaint? Underhand deals?
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'A murder!? '
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I haven't heard anyone complain about getting killed today.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: You know what, I'm busy. Real busy. Busier than you believe.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I'm running an entire resturant out back right now.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'So here, help me so I can help you. '
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Go grab me some stuff to smash together and sell to someone.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Grab what? I don't know! I'm the owner, not the chef!
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
