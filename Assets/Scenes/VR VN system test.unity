  m_Script: {fileID: 11500000, guid: 44513323b218ba049826813477c045eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 1335665689}
  conversation:
  - text: 'You hearing you, me?

      Click me, you.'
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: This is the place.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: It has to be.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Too many places on the list have come up with nothing.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: That man was killed here.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I can bet KATHERINE on it.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: With her at my waist, we can find it.
    onLineEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Let's rock.
    onLineEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 204564023}
          m_TargetAssemblyTypeName: LightManager, Assembly-CSharp
          m_MethodName: SetSingleLightActive
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
